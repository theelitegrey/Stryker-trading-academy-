# ---------------------------------------------------------------------------
# Security headers (added after the 2026-09 audit)
#
# These apply to every response. The two that do real work:
#
#   X-Frame-Options / frame-ancestors — nothing may embed this site in a
#   frame. Without it, a clickjacking page can overlay an invisible copy of
#   the dashboard and harvest clicks on real buttons.
#
#   Content-Security-Policy — the backstop for injected markup. It is
#   deliberately shipped in REPORT-ONLY mode first: it changes nothing for
#   visitors and only logs violations to the browser console. Load every page
#   signed in, read the violations, widen this list where the site legitimately
#   needs an origin, and only then rename the header to Content-Security-Policy
#   to start enforcing it.
#
#   'unsafe-inline' is in script-src because the pages carry inline <script>
#   blocks and inline event handlers. It is the honest description of the site
#   as it stands, and it is also the thing that most limits CSP's value here —
#   moving those handlers to addEventListener is what would let it come out.
#
# connect-src lists what the app actually talks to: Firebase (Auth, Firestore,
# Storage, Installations), our own Cloud Functions, the monitor data branch on
# raw.githubusercontent.com, and the keyless market/news feeds behind the
# Global Monitor and the charts.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(self "https://checkout.razorpay.com"), usb=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Content-Security-Policy-Report-Only: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self' https://checkout.razorpay.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.gstatic.com https://cdn.jsdelivr.net https://checkout.razorpay.com https://s3.tradingview.com https://www.tradingview.com https://www.youtube.com https://s.ytimg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' https: blob:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.firebaseapp.com https://*.cloudfunctions.net https://raw.githubusercontent.com https://api.dicebear.com https://api.binance.com https://api.binance.us https://data-api.binance.vision https://api.gdeltproject.org https://gamma-api.polymarket.com https://s3.tradingview.com https://checkout.razorpay.com https://lumberjack.razorpay.com; frame-src https://www.youtube.com https://www.youtube-nocookie.com https://s3.tradingview.com https://www.tradingview.com https://api.razorpay.com https://checkout.razorpay.com https://*.firebaseapp.com; worker-src 'self' blob:

# Cloudflare Pages headers (ignored by GitHub Pages, which serves this as a
# plain file — harmless there).
#
# Caching strategy matches the site's ?v= versioning scheme:
# - Assets are safe to cache for a year: every change bumps the ?v= query in
#   the HTML, and a changed query string is a different cache entry.
# - HTML must revalidate every time, or students sit on stale markup — the
#   exact problem the stryker-build/version-check system was built to patch
#   on GitHub Pages, solved properly here.

/assets/*
  Cache-Control: public, max-age=31536000
  X-Content-Type-Options: nosniff

# version.json is the one /assets/ file that must NEVER be cached — it is the
# source of truth the stale-page reload check compares against. The in-page
# fetch already cache-busts with ?t=, but this keeps the bare URL honest too.
# Listed after /assets/* so its Cache-Control wins.
/assets/version.json
  Cache-Control: no-store

# The pre-market brief is rewritten every session. A cached copy would show
# yesterday's plan as today's, which is the one failure this feature exists to
# avoid, so it revalidates on every request.
/assets/market-brief.json
  Cache-Control: public, max-age=0, must-revalidate

# Same for the cross-asset map, for the same reason: it is dated content
# living under a path that is otherwise cached for a year.
/assets/market-map.json
  Cache-Control: public, max-age=0, must-revalidate

# And the economic calendar, which goes wrong the fastest of the three: a
# cached copy would show a release time that has already passed.
/assets/econ-calendar.json
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  Cache-Control: public, max-age=0, must-revalidate

/manifest.json
  Cache-Control: public, max-age=0, must-revalidate

/firebase-messaging-sw.js
  Cache-Control: public, max-age=0, must-revalidate
