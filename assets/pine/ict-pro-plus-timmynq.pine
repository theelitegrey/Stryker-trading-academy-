kl_pdLabel  = input.bool(true, "Label", inline = "pd", group = G_KL)
kl_pdSize   = input.string("Tiny", "", options = ["Tiny", "Small", "Normal", "Large"], inline = "pd", group = G_KL)
kl_asShow   = input.bool(true, "Asia H / L", inline = "as", group = G_KL)
kl_asColor  = input.color(#f23645, "", inline = "as", group = G_KL)
kl_asStyle  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "as", group = G_KL)
kl_asLabel  = input.bool(true, "Label", inline = "as", group = G_KL)
