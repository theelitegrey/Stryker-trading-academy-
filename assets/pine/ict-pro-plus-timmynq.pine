//@version=6
indicator("ICT Pro+ | TimmyNQ [TakingProphets]", shorttitle = "ICT Pro+ | TimmyNQ", overlay = true, max_lines_count = 500, max_labels_count = 500, max_boxes_count = 500, max_bars_back = 5000)

const string G_CONF = "Confluences"
const string G_HTF  = "High Timeframe Gaps"
const string G_KL   = "Key Liquidity"
const string G_LRL  = "Low Resistance Liquidity"
const string G_KO   = "Key Opens"
const string G_KZ   = "Killzones / Sessions"
const string G_SMT  = "SMT Divergence"

conf_ifvgShow  = input.bool(true, "Inversion FVGs", inline = "ifvg", group = G_CONF, tooltip = "After a liquidity sweep, the most recent qualifying Fair Value Gap that price closes through is drawn as an inversion box. Max keeps only the most recent N inversion boxes.")
conf_ifvgMax   = input.int(2, "Max", minval = 1, maxval = 20, inline = "ifvg", group = G_CONF)
conf_ifvgBull  = input.color(#2157f333, "", inline = "ifvg", group = G_CONF)
conf_ifvgBear  = input.color(#13172233, "", inline = "ifvg", group = G_CONF)
conf_fvgShow   = input.bool(false, "Fair Value Gaps", inline = "fvg", group = G_CONF, tooltip = "Draws the pending gap before it inverts. It flips to the inversion colors the moment price closes through it. Gaps that never invert are removed automatically.")
conf_fvgBull   = input.color(#2157f31a, "", inline = "fvg", group = G_CONF)
conf_fvgBear   = input.color(#1317221a, "", inline = "fvg", group = G_CONF)
conf_cisdShow  = input.bool(true, "CISDs", inline = "cisd", group = G_CONF, tooltip = "After a liquidity sweep, the open of the delivering leg is tracked. A close back through it prints a CISD line. A CISD whose implied stop is violated is removed.")
conf_cisdMax   = input.int(2, "Max", minval = 1, maxval = 20, inline = "cisd", group = G_CONF)
conf_cisdBull  = input.color(color.black, "Bullish", inline = "cisd_s", group = G_CONF)
conf_cisdBear  = input.color(color.black, "Bearish", inline = "cisd_s", group = G_CONF)
conf_cisdStyle = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "cisd_s", group = G_CONF)
conf_cisdThick = input.string("Thin", "", options = ["Thin", "Medium", "Thick"], inline = "cisd_s", group = G_CONF)
conf_lblShow   = input.bool(true, "Labels", inline = "clbl", group = G_CONF, tooltip = "Tags FVG and CISD drawings. Inversion boxes are intentionally left unlabeled.")
conf_lblColor  = input.color(color.black, "", inline = "clbl", group = G_CONF)
conf_lblSize   = input.string("Tiny", "", options = ["Tiny", "Small", "Normal", "Large"], inline = "clbl", group = G_CONF)

htf_show      = input.bool(true, "Show Gaps", group = G_HTF, tooltip = "Scans two higher timeframes auto-selected from the chart interval and shows only the single closest unmitigated gap per side.")
htf_bullColor = input.color(#787b8633, "Bullish", inline = "htfc", group = G_HTF)
htf_bearColor = input.color(#787b8633, "Bearish", inline = "htfc", group = G_HTF)
htf_border    = input.bool(false, "Border", inline = "htfc", group = G_HTF)
htf_lblColor  = input.color(#5d606b, "Label", inline = "htfl", group = G_HTF)
htf_lblSize   = input.string("Tiny", "", options = ["Tiny", "Small", "Normal", "Large"], inline = "htfl", group = G_HTF)

kl_pwShow   = input.bool(true, "PWH / PWL", inline = "pw", group = G_KL)
kl_pwColor  = input.color(#7e57c2, "", inline = "pw", group = G_KL)
kl_pwStyle  = input.string("Solid", "", options = ["Solid", "Dashed", "Dotted"], inline = "pw", group = G_KL)
kl_pwLabel  = input.bool(true, "Label", inline = "pw", group = G_KL)
