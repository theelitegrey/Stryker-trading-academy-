# ---- Stryker social automation: server settings ---------------------------
# Copy to .env on the VPS. Never commit .env.

# Where this server is reachable on the public internet (Instagram and Threads
# fetch video files from here). No trailing slash.
PUBLIC_BASE_URL=https://social.strykertrading.com
PORT=8787
# Basic-auth password for the admin page (user is "admin").
ADMIN_PASSWORD=change-me
# Where the queue database and rendered media live.
DATA_DIR=./data

# ---- Content sources -------------------------------------------------------
SITE_URL=https://strykertrading.com
MONITOR_URL=https://raw.githubusercontent.com/theelitegrey/Stryker-trading-academy-/data/monitor-data.json
# Optional: a Firebase service-account JSON file so chapters, models,
# indicators and live sessions are read live from Firestore. Without it the
# lesson producer reads the bundled seed at ../assets/chapters-data.js.
FIREBASE_SERVICE_ACCOUNT=

# ---- Drafting --------------------------------------------------------------
ANTHROPIC_API_KEY=

# ---- Voices (OpenAI-compatible /v1/audio/speech servers) -------------------
# Chatterbox first, Kokoro as fallback. Leave both empty for caption-only videos.
CHATTERBOX_URL=http://chatterbox:8004
CHATTERBOX_VOICE=stryker.wav
KOKORO_URL=http://kokoro:8880
KOKORO_VOICE=am_michael

# ---- X (developer.x.com, OAuth 1.0a user context, read+write) -------------
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_HANDLE=

# ---- Meta: Instagram Reels + Threads --------------------------------------
# From the Meta app (developers.facebook.com). See SETUP.md.
META_APP_ID=
META_APP_SECRET=
# Instagram Business/Creator account id and a long-lived user token.
IG_USER_ID=
IG_ACCESS_TOKEN=
# Threads user id and long-lived Threads token (separate app product).
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# ---- YouTube (Google Cloud OAuth client, YouTube Data API v3) -------------
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
