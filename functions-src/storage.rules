// TradeZoro — Firebase Storage rules (Creator Hub). Reference copy; published to the firebase.storage release.
// The bucket was switched on 2026-10-30 for Creator Hub (before that the project had no bucket and every path was denied).
//
// communities/{cid}/branding/{logo|cover}   community logo and cover: images only, 5 MB max, owner or community admin writes.
//                                           Public read (the community page shows them to signed-out visitors).
// communities/{cid}/files/{fid}            course files (phase C): owner writes, 25 MB per file, only against a Firestore reservation
//                                           (files/{fid}) whose size and type must match. Reads: owner only; members are served
//                                           by /api/creator/file. The 1 GB cap is the Firestore stats/storage total (see firestore.rules).
// suggestions/{uid}/{file}                 Suggestions board screenshots (2026-10-30): public read, own uid, images < 5 MB.
// Everything else stays denied.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function cm(cid)       { return firestore.get(/databases/(default)/documents/communities/$(cid)).data; }
    function myMem(cid)    { return firestore.get(/databases/(default)/documents/communities/$(cid)/members/$(request.auth.uid)).data; }
    function isMember(cid) { return request.auth != null && firestore.exists(/databases/(default)/documents/communities/$(cid)/members/$(request.auth.uid)); }
    function isOwner(cid)  { return request.auth != null && cm(cid).ownerUid == request.auth.uid; }
    function isCmAdmin(cid) { return isMember(cid) && myMem(cid).role == 'admin' && myMem(cid).status == 'active'; }
    function staff(cid) { return isOwner(cid) || isCmAdmin(cid); }
    function active(cid) { return cm(cid).status == 'active'; }
    function isSiteAdmin() { return request.auth != null && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)); }

    match /communities/{cid}/branding/{name} {
      allow read: if true;
      allow write: if staff(cid) && active(cid)
                   && name in ['logo', 'cover']
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if staff(cid) || isSiteAdmin();
    }

    // Indicator screenshots (Creator Hub phase B): public read (cards on the community page), owner writes images < 5 MB.
    match /communities/{cid}/shots/{iid}/{name} {
      allow read: if true;
      allow write: if isOwner(cid) && active(cid)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(png|jpeg|webp)');
      allow delete: if isOwner(cid) || isSiteAdmin();
    }

    // Course files (Creator Hub phase C): PDFs, images, attachments. Path: communities/{cid}/files/{fid}.
    // The owner reserves the file first in Firestore (communities/{cid}/files/{fid}, which also moves the 1 GB total in
    // the same batch), then uploads. Storage accepts the upload only if it matches that reservation: same size, same type,
    // under 25 MB. Nobody but the owner reads through Storage rules; members get the bytes through the Pages Function
    // /api/creator/file, which first lets Firestore decide (plan, drip, order) and adds the watermark on the viewer page.
    match /communities/{cid}/files/{fid} {
      function reg() { return firestore.get(/databases/(default)/documents/communities/$(cid)/files/$(fid)).data; }
      allow read: if isOwner(cid) || isSiteAdmin();
      allow create: if isOwner(cid) && active(cid)
                    && firestore.exists(/databases/(default)/documents/communities/$(cid)/files/$(fid))
                    && request.resource.size < 25 * 1024 * 1024
                    && request.resource.size == reg().size
                    && request.resource.contentType == reg().ct;
      allow update: if false;
      allow delete: if isOwner(cid) || isSiteAdmin();
    }

    // Suggestions board screenshots: suggestions/{uid}/{file}. Public read (the board is public), the member writes
    // only under their own uid, images only, under 5 MB. Admins may delete (spam).
    match /suggestions/{uid}/{file} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(png|jpeg|webp|gif)');
      allow delete: if (request.auth != null && request.auth.uid == uid) || isSiteAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
