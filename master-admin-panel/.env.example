# Port the panel listens on
PORT=8080
# Optional: preset the admin password (otherwise you set it on first visit)
ADMIN_PASSWORD=
# Optional: where JSON data files live (default ./data)
DATA_DIR=./data
# Optional: seed demo sites/subscriptions on first run (1 = yes)
SEED_DEMO=1
# Optional: Slack/Discord/generic webhook that receives alerts
ALERT_WEBHOOK_URL=
