[Unit]
Description=TradeZoro deep history: daily 1-minute top-up, all 6 futures (last 2 days, then post to the store)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Nice=15
Environment=TICKSTREAM_ENV=/root/.hermes/profiles/chief-of-staff/scripts/tickstream.env
Environment=INSIGHTSENTRY_ENV=/root/.hermes/profiles/chief-of-staff/scripts/insightsentry.env
Environment=FEEDER_ENV=/root/projects/book-feeder/feeder.env
ExecStart=/usr/bin/python3 /opt/tz-hist/backfill_m1.py --symbols NQ,ES --days 3 --redo-days 2 --out /var/lib/tz-hist --post
ExecStart=/usr/bin/python3 /opt/tz-hist/backfill_is_m1.py --symbols YM,RTY,MNQ,MES --days 3 --redo-days 2 --out /var/lib/tz-hist --post
