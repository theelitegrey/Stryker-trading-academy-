//@version=6
indicator("t2", overlay=true)
string ta = input.text_area("hello {{x}}", "Msg")
float s = input.source(close, "Src")
string tf = input.timeframe("240", "TF")
type PerfTracker
    int wins = 0
    int losses = 0
    array<float> hist
method winRate(PerfTracker this) =>
    this.wins + this.losses > 0 ? 100.0 * this.wins / (this.wins + this.losses) : na
var PerfTracker pt = PerfTracker.new(0, 0, array.new_float())
var array<PerfTracker> pts = array.new<PerfTracker>()
if bar_index % 3 == 0
    pt.wins += 1
else if bar_index % 7 == 0
    pt.losses += 1
if barstate.isfirst
    pts.push(PerfTracker.new(1, 1, array.new_float()))
f(x) => ta.ema(x, 10) > ta.ema(x, 20) ? 1 : -1
int hd = request.security(syminfo.tickerid, tf, f(close)[1], lookahead = barmerge.lookahead_on)
var array<float> w = array.new_float()
w.push(close)
if w.size() > 20
    w.shift()
float p50 = w.percentile_linear_interpolation(50)
array<int> idx = w.sort_indices(order.ascending)
float secs = timeframe.in_seconds(tf)
float secs2 = timeframe.in_seconds()
string ft = str.format_time(time, "yyyy-MM-dd HH:mm", syminfo.timezone)
color g = color.from_gradient(close, 95, 105, color.red, color.green)
plot(pt.winRate(), "wr")
plot(pts.get(0).winRate(), "wr2")
plot(hd, "hd")
plot(p50, "p50")
plot(idx.get(0), "idx0")
plot(secs, "secs")
plot(secs2, "secs2")
plot(str.length(ta), "talen")
plot(s, "src")
barcolor(g, title="bc")
plotcandle(open, high, low, close, "C", g, g, bordercolor = g)
alert("x " + ft, alert.freq_once_per_bar_close)
alertcondition(close > open, "up", "up")
var table t = table.new(position.bottom_right, 3, 3)
if barstate.islast
    t.cell(0, 0, ft)
    t.cell(0, 2, "footer")
    t.merge_cells(0, 2, 2, 2)
