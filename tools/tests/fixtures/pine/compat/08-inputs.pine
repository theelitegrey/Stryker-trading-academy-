//@version=5
indicator("Inputs", overlay=true)
len = input.int(20, "Length", minval=1)
mult = input.float(1.5, "Mult", step=0.1)
src = input.source(close, "Source")
col = input.color(color.teal, "Colour")
show = input.bool(true, "Show")
tf = input.timeframe("60", "Timeframe")
sess = input.session("0930-1600", "Session")
mode = input.string("A", "Mode", options=["A", "B"])
plot(show ? ta.sma(src, len) * (mode == "A" ? 1 : mult) : na, color=col)
