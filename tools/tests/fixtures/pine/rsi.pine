//@version=5
indicator("RSI with bands", overlay=false)
len = input.int(14, "Length", minval=1)
upper = input.int(70, "Upper band")
lower = input.int(30, "Lower band")
r = ta.rsi(close, len)
plot(r, "RSI", color=color.purple, linewidth=2)
hline(upper, "Upper", color=color.red)
hline(50, "Middle", color=color.gray)
hline(lower, "Lower", color=color.green)
