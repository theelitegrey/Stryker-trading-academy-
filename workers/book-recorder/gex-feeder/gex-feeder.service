[Unit]
Description=TradeZoro GEX chain feeder: Cboe option chains -> compact chains -> book recorder Worker (one run)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/root/projects/book-feeder/feeder.env
ExecStart=/usr/bin/python3 /root/projects/book-feeder/gex_feeder.py
# every 1 min (Cboe file changes once a minute); 4 symbols x (fetch <= 40 s + 2 POSTs <= 15 s) worst case, normally ~3-5 s total
TimeoutStartSec=110
MemoryMax=160M
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
# ZoroTide keeps the last volume per contract between runs (a few hundred KB per symbol)
StateDirectory=gex-feeder
Environment=TIDE_STATE_DIR=/var/lib/gex-feeder
SyslogIdentifier=gex-feeder
