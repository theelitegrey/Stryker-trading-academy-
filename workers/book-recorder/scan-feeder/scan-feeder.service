[Unit]
Description=TradeZoro market scanner feeder: InsightSentry screeners -> presets + tables -> book recorder Worker (one run)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# recorder URL + shared ingest secret, and the InsightSentry key (both files mode 0600; never logged)
EnvironmentFile=/root/projects/book-feeder/feeder.env
EnvironmentFile=/root/.hermes/profiles/chief-of-staff/scripts/insightsentry.env
ExecStart=/usr/bin/python3 /root/projects/book-feeder/scan_feeder.py
# 4 screener calls (~1-3 s each) + 4 small POSTs; normally ~15 s
TimeoutStartSec=150
MemoryMax=150M
Nice=10
StateDirectory=scan-feeder
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
SyslogIdentifier=scan-feeder
