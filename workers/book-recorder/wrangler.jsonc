{
  "name": "book-recorder",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RECORDER", "class_name": "BookRecorder" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BookRecorder"] }],
  "triggers": { "crons": [] },
  "ratelimits": [
    { "name": "RL", "namespace_id": "52401", "simple": { "limit": 20, "period": 60 } },
    { "name": "RLN", "namespace_id": "52402", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_OF", "namespace_id": "52403", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_ZX", "namespace_id": "52404", "simple": { "limit": 6, "period": 60 } },
    { "name": "RL_HL", "namespace_id": "52405", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_LV", "namespace_id": "52406", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": { "SYMBOLS": "BTCUSDT,ETHUSDT", "IS_MAX_LEGS": "5", "IS_MAX_SOCKETS": "1", "TS_ACCESS": "pro", "TS_MODE": "direct", "TS_KEEP_HOURS": "48", "TS_MAX_CLIENTS": "150" },
  "observability": { "enabled": true }
}
